<view class="card">
  <view class="task">
    <view class="check {{item.checked ? 'on' : ''}}" bindtap="onToggle">{{item.checked ? '✓' : ''}}</view>
    <view class="meta">
      <view class="name">{{item.name}}</view>
      <view class="other">{{item.other}}</view>
      <view class="dose">{{item.dose}}</view>
    </view>
  </view>
  <view class="guide" bindtap="onGuide">{{guide}}</view>
  <view wx:if="{{open}}" class="pose">
    <image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill" />
    <view class="body">
      <view class="hint">{{hint}}</view>
      <view wx:for="{{item.how}}" wx:for-item="step" wx:key="*this" class="step">{{index + 1}}. {{step}}</view>
      <view class="warn">{{item.tip}}</view>
    </view>
  </view>
</view>
